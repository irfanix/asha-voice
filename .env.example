# ASHA Voice — server-side environment variables
# Copy this file to `.env` for local testing, or set these in the
# Vercel dashboard when deploying. NEVER commit your real `.env`.

# OpenAI-compatible chat completions endpoint
LLM_BASE_URL=https://api.featherless.ai/v1

# Your API key (kept only on the server — never sent to the browser)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Model name as the provider expects it
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct